<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 900 500" width="900" height="500">
  <defs>
    <linearGradient id="grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#123F29;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#0b2619;stop-opacity:1" />
    </linearGradient>
    <pattern id="pattern" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 40 M 0 0 L 40 40" fill="none" stroke="rgba(213, 174, 43, 0.08)" stroke-width="1.5" />
    </pattern>
  </defs>
  <rect width="100%" height="100%" fill="url(#grad)" />
  <rect width="100%" height="100%" fill="url(#pattern)" />
  <rect x="20" y="20" width="900" height="500" rx="16" fill="none" stroke="#D5AE2B" stroke-width="1.5" stroke-opacity="0.3" transform="scale(0.95)" />
  <g fill="#D5AE2B" opacity="0.85" transform="translate(40, 50)">
    <circle cx="20" cy="20" r="14" fill="none" stroke="#D5AE2B" stroke-width="2"/>
    <polygon points="20,10 24,18 33,18 26,24 28,32 20,27 12,32 14,24 7,18 16,18" fill="#D5AE2B"/>
  </g>
  <text x="50%" y="50%" font-family="system-ui, sans-serif" font-weight="bold" font-size="24" fill="#FFFFFF" text-anchor="middle" dy="-5">Pendaftaran LKMM-TD 2026</text>
  <text x="50%" y="50%" font-family="system-ui, sans-serif" font-weight="normal" font-size="14" fill="#D5AE2B" text-anchor="middle" dy="25">Kaderisasi Kepemimpinan Mahasiswa</text>
</svg>