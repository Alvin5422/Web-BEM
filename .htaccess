<IfModule mod_rewrite.c>
    RewriteEngine On

    # Blokir akses langsung ke file sensitif
    RewriteRule ^(\.env|\.git|database|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml) - [F,L,NC]

    # Arahkan semua request ke folder public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

